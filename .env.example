# Credenciais do Supabase (projeto criado em https://supabase.com).
# Copie este arquivo para ".env.local" e preencha com os valores reais.
# Nunca exponha a SERVICE ROLE KEY no navegador — ela só é usada nas
# API Routes do servidor (app/api/**/route.ts).

# Project Settings > API > Project URL
SUPABASE_URL=

# Project Settings > API > Project API keys > service_role (secreta!)
SUPABASE_SERVICE_ROLE_KEY=
